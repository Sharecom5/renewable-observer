# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel these belong in Project Settings → Environment Variables.

# ---------------------------------------------------------------
# LinkedIn auto-poster  (src/app/api/cron/linkedin)
# ---------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Shared secret for the LinkedIn cron. Send it as `Authorization: Bearer <value>`;
# the `?secret=` query parameter still works but ends up in access logs.
CRON_SECRET=

# ---------------------------------------------------------------
# Instant indexing  (src/app/api/instant-index)
# Without all three, the route returns 503 and no indexing pings are sent.
# ---------------------------------------------------------------
INDEXING_SECRET=
GOOGLE_CLIENT_EMAIL=
# Paste the service account key with literal \n escapes, wrapped in quotes.
GOOGLE_PRIVATE_KEY=

# ---------------------------------------------------------------
# Newsletter  (src/app/actions/subscribe.ts)
# Any endpoint accepting POST {"email": "...", "source": "..."} — Mailchimp,
# Resend Audiences, Buttondown, Zapier. Unset means signups are refused with a
# visible message rather than silently discarded.
# ---------------------------------------------------------------
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_TOKEN=

# ---------------------------------------------------------------
# Content sync scripts  (scripts/*.js — not used by the app at runtime)
# A WordPress application password, not the account password. Revoke and
# reissue from WP Admin → Users → Profile → Application Passwords.
# ---------------------------------------------------------------
WP_USER=
WP_APP_PASS=
